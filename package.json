{
  "name": "diagram-desk",
  "version": "1.0.0",
  "description": "A static technical learning platform with interactive Archify diagrams.",
  "keywords": [
    "archify",
    "diagrams",
    "learning",
    "architecture",
    "astro",
    "articles"
  ],
  "license": "MIT",
  "author": "Diagram Desk contributors",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/build-readers.mjs && astro dev",
    "build": "node scripts/build-readers.mjs && astro build && node scripts/decorate-external-links.mjs",
    "preview": "astro preview",
    "check": "node scripts/check-migration.mjs && astro check",
    "check:migration": "node scripts/check-migration.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "test": "node --test scripts/external-links.test.mjs && npm run check && npm run build && node scripts/check-static.mjs",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "files": [
    "src",
    "dist",
    "public",
    "scripts",
    "vendor/archify",
    "catalog"
  ],
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "astro": "^7.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "parse5": "^8.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qwertypants/diagram-desk.git"
  },
  "homepage": "https://qwertypants.github.io/diagram-desk/",
  "bugs": {
    "url": "https://github.com/qwertypants/diagram-desk/issues"
  }
}
