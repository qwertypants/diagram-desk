{
  "name": "diagram-desk",
  "version": "1.0.0",
  "description": "A local visual learning library for software and AI systems, powered by Archify.",
  "keywords": [
    "archify",
    "diagrams",
    "learning",
    "architecture",
    "sqlite",
    "local-first",
    "offline"
  ],
  "license": "MIT",
  "author": "Diagram Desk contributors",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "serve": "node server/index.js",
    "test": "node --test",
    "test:browser": "node scripts/browser-check.mjs",
    "migrate:archify": "node scripts/migrate-archify.mjs",
    "check:catalog": "node scripts/check-catalog.mjs"
  },
  "files": [
    "index.html",
    "src",
    "server",
    "dist",
    "vendor/archify",
    "catalog"
  ],
  "devDependencies": {
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "vite": "^8.3.2"
  }
}
