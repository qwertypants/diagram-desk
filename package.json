{
  "name": "diagram-desk",
  "version": "1.0.0",
  "description": "A local-first library of Mermaid diagrams: write, preview, search, and edit saved diagrams offline, with a small Node server and SQLite storage.",
  "keywords": [
    "mermaid",
    "diagrams",
    "flowchart",
    "sqlite",
    "local-first",
    "offline"
  ],
  "license": "MIT",
  "author": "Diagram Desk contributors",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "serve": "node server/index.js",
    "test": "node --test",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "files": [
    "index.html",
    "src",
    "server",
    "dist"
  ],
  "dependencies": {
    "mermaid": "^12.1.0"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "vite": "^8.3.2"
  }
}