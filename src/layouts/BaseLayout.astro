---
import { withBase } from '../lib/urls';
import '../styles/global.css';
const { title = 'Diagram Desk', description = 'Visual field notes for building reliable systems.', canonical } = Astro.props;
const pageTitle = title === 'Diagram Desk' ? title : `${title} — Diagram Desk`;
const canonicalPath = canonical ? withBase(canonical) : Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#201f1b" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header"><div class="header-inner"><a href={withBase('/')} class="brand" aria-label="Diagram Desk home"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>diagram<span class="brand-light">desk</span></span></a><nav aria-label="Main navigation"><a href={withBase('/articles/')}>Articles</a><a href={withBase('/topics/')}>Topics</a></nav><span class="header-note">A FIELD GUIDE TO SYSTEMS</span></div></header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="footer-inner"><div><span class="footer-brand">diagramdesk</span><p>Clear thinking for complex systems.</p></div><div class="footer-links"><a href={withBase('/articles/')}>All articles</a><a href={withBase('/topics/')}>Browse topics</a></div><span class="footer-end">Built to be read.</span></div></footer>
  </body>
</html>
