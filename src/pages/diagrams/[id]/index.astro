---
import { withBase } from '../../../lib/urls';
import legacy from '../../../legacy-ids.json';
import { getCollection, type CollectionEntry } from 'astro:content';
import DiagramCompanion from '../../../components/DiagramCompanion.astro';

type Props = { kind: 'redirect'; slug: string } | {
  kind: 'companion';
  companion: CollectionEntry<'companions'>;
  article: CollectionEntry<'articles'>;
};

export async function getStaticPaths() {
  const [companions, articles] = await Promise.all([getCollection('companions'), getCollection('articles')]);
  const companionPaths = companions.map(companion => {
    const article = articles.find(entry => entry.id === companion.id);
    if (!article) throw new Error(`Companion ${companion.id} has no matching article.`);
    return { params: { id: companion.id }, props: { kind: 'companion', companion, article } satisfies Props };
  });
  const redirects = Object.entries(legacy).map(([id, slug]) => ({ params: { id }, props: { kind: 'redirect', slug } satisfies Props }));
  return [...companionPaths, ...redirects];
}
const props = Astro.props;
const target = props.kind === 'redirect' ? withBase(`/articles/${props.slug}/`) : '';
---
{props.kind === 'companion' ? <DiagramCompanion companion={props.companion} article={props.article} /> : <Fragment><Fragment set:html="<!doctype html>" /><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta http-equiv="refresh" content={`0;url=${target}`} /><meta name="robots" content="noindex" /><link rel="canonical" href={target} /><title>Article moved — Diagram Desk</title></head><body><main><h1>This guide has moved.</h1><p>Continue to <a href={target}>the article</a>.</p></main></body></html></Fragment>}
