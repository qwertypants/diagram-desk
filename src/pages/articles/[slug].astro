---
import { withBase } from '../../lib/urls';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({ params: { slug: article.id }, props: { article, articles } }));
}
const { article, articles } = Astro.props as { article: CollectionEntry<'articles'>; articles: CollectionEntry<'articles'>[] };
const { Content, headings } = await render(article);
const relatedSlugs = article.data.related ?? [];
const related = relatedSlugs.length ? relatedSlugs.map(slug => articles.find(candidate => candidate.id === slug)).filter((entry): entry is CollectionEntry<'articles'> => Boolean(entry)) : articles.filter(candidate => candidate.id !== article.id && candidate.data.topic === article.data.topic).slice(0,2);
const date = article.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title={article.data.title} description={article.data.description} canonical={`/articles/${article.id}/`}>
  <article class="article-page"><header class="article-hero wrap"><div class="article-breadcrumb"><a href={withBase('/articles/')}>The library</a><span aria-hidden="true">/</span><a href={withBase(`/topics/${article.data.topic.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'')}/`)}>{article.data.topic}</a></div><div class="eyebrow">A VISUAL FIELD NOTE <span class="eyebrow-dot">·</span> {article.data.difficulty}</div><h1>{article.data.title}</h1><p class="article-deck">{article.data.description}</p><div class="article-meta"><time datetime={article.data.pubDate.toISOString()}>{date}</time><span aria-hidden="true">·</span><span>{article.data.tags.join(' / ')}</span></div></header>
    <div class="article-body-wrap wrap"><aside class="article-aside" aria-label="On this page"><div class="aside-title">IN THIS GUIDE</div><nav>{headings.filter(heading => heading.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav><a class="aside-diagram" href="#diagram-heading">Explore the diagram ↗</a></aside><div class="article-main"><div class="learning-box"><div class="box-kicker">WHAT YOU’LL LEARN</div><ul>{article.data.objectives.map(objective => <li>{objective}</li>)}</ul></div><div class="prose"><Content /></div></div></div>
  </article>
  <section class="related-section wrap"><div class="section-heading"><div><div class="eyebrow">KEEP EXPLORING</div><h2>Continue the thread.</h2></div><a class="text-link" href={withBase('/articles/')}>All articles ↗</a></div><div class="article-grid">{related.map((item,index) => <ArticleCard article={item} index={index} />)}</div></section>
</BaseLayout>
