---
import { withBase } from '../lib/urls';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { sortArticlesByDate } from '../lib/articles';
const articles = sortArticlesByDate(await getCollection('articles'));
const topics: string[] = [...new Set<string>(articles.map(item => String(item.data.topic)))].sort();
---
<BaseLayout title="Diagram Desk" description="Visual field notes for building reliable software and AI systems.">
  <section class="hero wrap"><div class="eyebrow"><span class="eyebrow-line"></span> AN ENGINEERING PUBLICATION</div><div class="hero-grid"><div><h1>Understand the system.<br /><em>See how it works.</em></h1><p>Deep, visual guides to the architecture behind reliable software and AI. Read the reasoning, explore the diagram, and take the ideas into your own work.</p><a class="primary-link" href={withBase('/articles/')}>Explore the articles <span aria-hidden="true">→</span></a></div><div class="hero-art" aria-hidden="true"><span class="art-label art-label-top">INPUT</span><span class="art-node node-one"></span><span class="art-node node-two"></span><span class="art-node node-three"></span><span class="art-node node-four"></span><span class="art-line line-one"></span><span class="art-line line-two"></span><span class="art-line line-three"></span><span class="art-label art-label-bottom">SYSTEM / 01</span></div></div><div class="hero-bottom"><span>{String(articles.length).padStart(2,'0')} FIELD NOTES</span><span>DIAGRAMS INCLUDED WITH EVERY GUIDE</span><span>SCROLL TO EXPLORE ↓</span></div></section>
  <section class="listing wrap"><div class="section-heading"><div><div class="eyebrow">START READING</div><h2>Ideas worth <em>mapping out.</em></h2></div><a class="text-link" href={withBase('/articles/')}>View all articles <span aria-hidden="true">→</span></a></div><div class="article-grid">{articles.slice(0,6).map((article,index) => <ArticleCard article={article} index={index} />)}</div></section>
  <section class="topics-band"><div class="wrap topics-band-inner"><div><div class="eyebrow">FIND YOUR THREAD</div><h2>Explore by topic.</h2></div><div class="topic-links">{topics.map(topic => <a href={withBase(`/topics/${encodeURIComponent(topic.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,''))}/`)}>{topic}<span aria-hidden="true">→</span></a>)}</div></div></section>
</BaseLayout>
