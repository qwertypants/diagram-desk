---
import { withBase } from '../lib/urls';
import { getCollection } from 'astro:content';
interface Props {
  slug: string;
  title: string;
  heading?: string;
  cue?: string;
  companion?: boolean;
}
const { slug, title, heading = 'Explore the diagram', cue, companion = false } = Astro.props;
const url = withBase(`/diagrams/${slug}/reader.html`);
const hasCompanion = !companion && (await getCollection('companions')).some(entry => entry.id === slug);
const fullViewUrl = hasCompanion ? withBase(`/diagrams/${slug}/`) : url;
---
<section class="diagram-section" aria-labelledby="diagram-heading">
  <div class="section-eyebrow">INTERACTIVE DIAGRAM</div>
  <div class="diagram-heading-row"><h2 id="diagram-heading">{heading}</h2><a href={companion ? url : fullViewUrl}>{companion ? 'Open canvas only' : 'Open full view'} <span aria-hidden="true">→</span></a></div>
  {cue && <p class="diagram-cue">{cue}</p>}
  <div class="diagram-frame"><iframe src={url} title={`Interactive diagram for ${title}`} loading="lazy" sandbox="allow-scripts allow-downloads"></iframe></div>
</section>
