# Optional local Astro development server. Reader HTML is generated by npm run dev.
local_resource(
    "diagram-desk",
    serve_cmd="npm run dev -- --host 127.0.0.1",
    deps=[
        "package.json",
        "astro.config.mjs",
        "src/",
        "catalog/",
        "scripts/build-readers.mjs",
        "vendor/archify/",
    ],
    links=["http://127.0.0.1:4321/"],
    readiness_probe=probe(
        http_get=http_get_action(port=4321, path="/"),
        initial_delay_secs=5,
        timeout_secs=60,
    ),
)
