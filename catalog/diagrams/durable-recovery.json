    },
    {
      "from": "running",
      "to": "checking",
      "label": "receipt"
    },
    {
      "from": "running",
      "to": "backoff",
      "label": "retryable failure"
    },
    {
      "from": "backoff",
      "to": "running",
      "label": "within deadline"
    },
    {
      "from": "backoff",
      "to": "failed",
      "label": "budget exhausted"
    },
    {
      "from": "running",
      "to": "reconcile",
      "label": "unknown outcome"
    },
    {
      "from": "reconcile",
      "to": "checking",
      "label": "receipt found"
    },
    {
      "from": "reconcile",
      "to": "backoff",
      "label": "confirmed not applied"
    },
    {
      "from": "checking",
      "to": "done",
      "label": "verified"
    },
    {
      "from": "checking",
      "to": "failed",
      "label": "invalid outcome"
